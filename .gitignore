# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# ── Ambienti virtuali ─────────────────────────────
venv/
env/
.env

# ── Log e IDE ─────────────────────────────────────
*.log
.vscode/
.idea/
.playwright-mcp/

# ── Build e binari ────────────────────────────────
# build/       → artifacts temporanei PyInstaller
# EXE/         → ultima build locale (26MB, non va nel repo)
# pre-release/ → candidate locali di test
# release/     → archivio locale release versionate (su GitHub ci pensa Actions)
build/
EXE/
pre-release/
release/
!EXE/.gitkeep
!pre-release/.gitkeep
!release/.gitkeep

# ── Certificati e segreti ─────────────────────────
*.pem

# ── Script e file locali (non per pubblicazione) ──
release.py
_archive/
docs/

# ── Configurazione locale Claude ──────────────────
.claude/
.superpowers/
CLAUDE.md

# ── File di sistema ───────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
